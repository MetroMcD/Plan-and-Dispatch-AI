# Plan & Dispatch — Konfiguration
# Diese Datei nach ".env" kopieren und Werte anpassen:  cp .env.example .env
# Alle Werte sind optional; ohne .env gelten die Defaults.

# ── Erstanmeldung ────────────────────────────────────────────────────────────
# PFLICHT: Ohne ADMIN_PASSWORD verweigert docker compose den Start.
# Nur beim ALLERERSTEN Start relevant (solange noch kein Benutzer existiert).
# Ist keins gesetzt (leer oder "admin", z. B. beim Start ohne die
# Compose-Dateien), erzeugt die App beim ersten Start ein zufälliges
# Startpasswort, schreibt es ins Container-Log (docker compose logs dispatcher)
# und nach /data/initial-admin-password.txt. Es muss beim ersten Login geändert
# werden; danach wird die Datei gelöscht. Ein bekanntes admin/admin gibt es nicht.
ADMIN_USER=admin
ADMIN_PASSWORD=

# ── Sicherheit ───────────────────────────────────────────────────────────────
# Schlüssel für die Session-Cookies. Leer lassen = wird beim ersten Start
# automatisch generiert und im Daten-Volume persistiert (empfohlen).
# Eigenen Wert erzeugen z.B. mit:  openssl rand -hex 32
SECRET_KEY=

# Session-Cookie nur über https senden (1 = an). Standard aus, weil der LAN-Betrieb
# über http://<host>:5050 läuft — dort käme ein Secure-Cookie nie an und niemand
# könnte sich anmelden. NUR einschalten, wenn die App ausschließlich über https
# erreichbar ist (Caddy, Cloudflare Tunnel, eigener Reverse-Proxy).
SESSION_COOKIE_SECURE=0

# Optionale Härtung (leer = aus bzw. bisheriges Verhalten):
# TRUSTED_PROXIES: IPs/CIDRs der vorgeschalteten Proxys (z. B. 172.18.0.0/16)
# TRUSTED_HOSTS:   erlaubte Hostnamen, kommagetrennt (z. B. dispatch.example.com)
TRUSTED_PROXIES=
TRUSTED_HOSTS=
MAX_REQUEST_MB=16

# ── Netzwerk ─────────────────────────────────────────────────────────────────
# HTTP-Port der App und HTTPS-Port des Caddy-Proxys (selbstsigniertes Zertifikat)
# Nur relevant für docker-compose.yml (LAN-Betrieb). Beim Produktiv-Setup hinter
# Cloudflare (docker-compose.prod.yml) werden KEINE Ports veröffentlicht.
HTTP_PORT=5050
HTTPS_PORT=5443

# ── Cloudflare Tunnel (nur docker-compose.prod.yml) ──────────────────────────
# Token aus dem Cloudflare-Dashboard: Zero Trust → Networks → Tunnels →
# Tunnel anlegen → Token kopieren. Ohne diesen Token startet cloudflared nicht.
TUNNEL_TOKEN=

# ── Backup ───────────────────────────────────────────────────────────────────
# Volle Stunde (lokale Zeit) für das nächtliche SQLite-Backup + Aufbewahrung
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14
# Benannte Sicherungen (manuell / vor Rücksicherung, Admin → Datenbank):
# je Art die neuesten N behalten — anzahl- statt altersbasiert
BACKUP_KEEP_MANUAL=10

# ── Zeitzone ─────────────────────────────────────────────────────────────────
TZ=Europe/Berlin
